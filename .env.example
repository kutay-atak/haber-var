# Bu dosyayı .env.local adıyla kopyala ve değerleri doldur.
# Ayrıntılı kurulum adımları README.md dosyasında.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Gizli anahtar: sadece sunucuda kullanılır, kimseyle paylaşma.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Cloudinary → Settings → API Keys
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail: Google Hesabı → Güvenlik → 2 Adımlı Doğrulama → Uygulama şifreleri
# Boş bırakırsan uygulama çalışır ama e-posta göndermez.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# İsteğe bağlı: Gmail yerine başka bir SMTP servisi (ör. Brevo: smtp-relay.brevo.com / 587).
# O zaman GMAIL_USER ve GMAIL_APP_PASSWORD o servisin kullanıcı adı ve şifresi olur,
# EMAIL_FROM da servisin onayladığı gönderen adresi.
# SMTP_HOST=
# SMTP_PORT=
# EMAIL_FROM=

# Zamanlanmış iş (Vercel Cron) için uzun, rastgele bir metin.
# Üretmek için: openssl rand -hex 32
CRON_SECRET=

# Uygulamanın adresi (e-postalardaki linkler için).
# Vercel'de boş bırakırsan otomatik olarak proje adresin kullanılır.
NEXT_PUBLIC_APP_URL=http://localhost:3000
